      "post_xor_steps": [
        {
          "step": "sync",
          "type": "barrier",
          "sync_point": "after_all_xor",
          "ranks": [0, 1, 2, 3]
        },
        {
          "_comment": "Send own parity to paired rank (Rank 1)",
          "step": "send",
          "type": "nccl_send",
          "target_rank": 1,
