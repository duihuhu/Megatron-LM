{
  "_comment": "4-rank EC-CHECK configuration example",
  "_description": "Example configuration for 4 ranks (0, 1, 2, 3) with shared parity buffer model",
  
  "ec_params": {
    "_comment": "Erasure Coding parameters: k = number of data nodes, m = number of parity nodes (rows)",
    "_note": "For 4 ranks: k=2 (data nodes), m=2 (parity rows), total encoded packets = k + m = 4",
    "k": 2,
    "m": 2
  },
  
  "persist": {
    "recv": true,
    "parity": true
  },
  
  "ranks": {
    "0": {
      "_comment": "Rank 0 configuration - 2 columns with shared parity",
      "columns": [
        {
          "_comment": "Column 0: Initialize shared parity with encoding XOR zero_parity",
          "column_idx": 0,
          "coefficient": 0,
          "pipeline": [
            {
              "step": "encode",
              "type": "ec_encode"
            },
            {
              "step": "send",
              "type": "nccl_send",
              "target_rank": 1,
              "count": 1
            },
            {
              "step": "xor",
              "type": "xor_update",
              "mode": "with_zero_parity",
              "sources": ["local_encoding"],
              "target": "parity",
              "_note": "Initializes shared parity: parity = encoding0 XOR zero_parity"
            }
          ]
        },
        {
          "_comment": "Column 1: Incrementally update shared parity with recv_encoding",
          "column_idx": 1,
          "coefficient": 1,
          "pipeline": [
            {
              "step": "encode",
              "type": "ec_encode"
            },
            {
              "step": "send",
              "type": "nccl_send",
              "target_rank": 1,
              "count": 1
            },
            {
              "step": "recv",
              "type": "nccl_recv",
              "source_rank": 1,
              "count": 1
            },
            {
              "step": "xor",
              "type": "xor_update",
              "mode": "incremental",
              "sources": ["parity", "recv_encoding"],
              "target": "parity",
              "_note": "Incremental update: parity = parity XOR recv_encoding1"
            }
          ]
        }
      ],
      "post_xor_steps": [
        {
          "_comment": "Synchronization barrier after all XOR operations complete",
          "step": "sync",
          "type": "barrier",
          "sync_point": "after_all_xor",
          "ranks": [0, 1, 2, 3]
        },
        {
          "_comment": "Send own parity to paired rank (Rank 2)",
          "step": "send",
          "type": "nccl_send",
          "target_rank": 2,
          "data_type": "parity",
          "data_source": "local_parity"
        },
        {
          "_comment": "Receive paired rank's data",
          "step": "recv",
          "type": "nccl_recv",
          "source_rank": 2,
          "data_type": "data",
          "data_target": "peer_data_buffer"
        }
      ]
    },
    "1": {
      "_comment": "Rank 1 configuration - symmetric to rank 0",
      "columns": [
        {
          "column_idx": 0,
          "coefficient": 0,
          "pipeline": [
            {
              "step": "encode",
              "type": "ec_encode"
            },
            {
              "step": "send",
              "type": "nccl_send",
              "target_rank": 0,
              "count": 1
            },
            {
              "step": "xor",
              "type": "xor_update",
              "mode": "with_zero_parity",
              "sources": ["local_encoding"],
              "target": "parity"
            }
          ]
        },
        {
          "column_idx": 1,
          "coefficient": 1,
          "pipeline": [
            {
              "step": "encode",
              "type": "ec_encode"
            },
            {
              "step": "send",
              "type": "nccl_send",
