          "data_target": "peer_data_buffer"
        }
      ]
    }
  },
  
  "_pairing_rules": {
    "_comment": "EC-CHECK pairing rules: rank_i ↔ rank_{i + world_size/2}",
    "_note": "For 4 ranks, pairs are: (0,2) and (1,3)",
    "rank_0": "paired with rank 2 (0 + 4/2 = 2)",
    "rank_1": "paired with rank 3 (1 + 4/2 = 3)",
    "rank_2": "paired with rank 0 (2 - 4/2 = 0)",
    "rank_3": "paired with rank 1 (3 - 4/2 = 1)"
  },
  
  "_usage": {
    "_comment": "This configuration file supports all 4 ranks (0-3)",
    "description": "Each rank reads its own configuration from the 'ranks' section using its rank number as key",
    "example": "Rank 0 reads from 'ranks.0', Rank 1 reads from 'ranks.1', etc."
  }
}

