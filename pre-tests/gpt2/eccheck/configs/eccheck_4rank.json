            },
            {
              "step": "xor",
              "type": "xor_update",
              "mode": "incremental",
              "sources": ["parity", "recv_encoding"],
              "target": "parity"
            }
          ]
        }
      ],
      "post_xor_steps": [
        {
          "step": "sync",
          "type": "barrier",
          "sync_point": "after_all_xor",
          "ranks": [0, 1, 2, 3]
        },
        {
          "_comment": "Send own parity to paired rank (Rank 3)",
          "step": "send",
          "type": "nccl_send",
          "target_rank": 3,
          "data_type": "parity",
          "data_source": "local_parity"
        },
        {
          "_comment": "Receive paired rank's data",
          "step": "recv",
          "type": "nccl_recv",
          "source_rank": 3,
          "data_type": "data",
          "data_target": "peer_data_buffer"
        }
      ]
    },
    "2": {
      "_comment": "Rank 2 configuration - similar to rank 0",
      "columns": [
        {
          "column_idx": 0,
